FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production STAGING_MODE=true
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gosu openssl && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/client/dist ./dist
COPY --from=build /app/dist-server ./dist-server
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY scripts/start-staging.sh ./start-staging.sh
CMD ["sh", "./start-staging.sh"]
